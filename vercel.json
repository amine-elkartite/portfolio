{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "installCommand": "npm ci --omit=dev --no-audit --no-fund",
  "functions": {
    "api/index.js": {
      "includeFiles": "{frontend/**,backend/uploads/**}",
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, max-age=0"}
      ]
    }
  ],
  "rewrites": [
    {"source": "/(.*)", "destination": "/api/index.js"}
  ]
}
