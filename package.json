{
  "name": "amine-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  },
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "db:init": "cd backend && node scripts/init-db.js",
    "admin:create": "cd backend && node scripts/create-admin.js",
    "test": "cd backend && node --test tests/*.test.js",
    "assets": "cd backend && node scripts/copy-assets.js"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "bcrypt": "^6.0.0",
    "chart.js": "^4.5.0",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide": "^0.468.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "mysql2": "^3.14.0",
    "pdfkit": "^0.20.2",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "nodemon": "^3.1.10"
  }
}
